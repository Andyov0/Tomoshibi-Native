    },
    "Whoever cannot reach YouTube, and whoever came in through a relay in mainland China, is given it through this deployment instead, sized to their player. Nobody needs a grant for it." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoever cannot reach YouTube, and whoever came in through a relay in mainland China, is given it through this deployment instead, sized to their player. Nobody needs a grant for it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YouTube に接続できない人と、中国本土の中継サーバーから参加した人には、このデプロイを経由して届けます。画質は各自のプレーヤーの大きさに合わせます。個別の許可は必要ありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连不上 YouTube 的人,以及从中国大陆的中转服务器进来的人,改由这个部署中转观看,画质按各自播放器的大小来定。不需要任何人单独开通。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連不上 YouTube 的人,以及從中國大陸的中轉伺服器進來的人,改由這個部署中轉觀看,畫質依各自播放器的大小而定。不需要任何人單獨開通。"
          }
        }
      }
    },
