    "Meetings here are started by the people who belong here. If somebody sent you a link, open that instead." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meetings here are started by the people who belong here. If somebody sent you a link, open that instead."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議はここの参加者が始めます。リンクを受け取っているなら、そちらを開いてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会议由这里的成员发起。如果有人给了你链接,直接打开它就好。"
          }
