          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回線から送れているのは約 {have} Mbps で、この共有には約 {need} Mbps 必要なため、映像がカクつきます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
