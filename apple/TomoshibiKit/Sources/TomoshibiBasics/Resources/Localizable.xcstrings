    "Your connection is sending about {have} Mbps, and this share needs about {need} Mbps, so it stutters." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your connection is sending about {have} Mbps, and this share needs about {need} Mbps, so it stutters."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "回線から送れているのは約 {have} Mbps で、この共有には約 {need} Mbps 必要なため、映像がカクつきます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的网络目前大约能发出 {have} Mbps,这次共享需要约 {need} Mbps,所以画面会卡顿。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的網路目前大約能送出 {have} Mbps,這次共享需要約 {need} Mbps,所以畫面會卡頓。"
          }
        }
      }
    },
