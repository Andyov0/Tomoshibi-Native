    },
    "Where a video comes in several qualities, it is never fetched sharper than this here. It applies from the next video you open." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where a video comes in several qualities, it is never fetched sharper than this here. It applies from the next video you open."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数の画質がある動画でも、ここではこれより高い画質では読み込みません。次に開く動画から適用されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频有多种清晰度时,这里最多只取到这一档。从下一个打开的视频开始生效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片有多種清晰度時,這裡最多只取到這一檔。從下一個打開的影片開始生效。"
          }
        }
      }
    },
