    "They joined without a passphrase, so they cannot run the room. Ask them to rejoin with one." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They joined without a passphrase, so they cannot run the room. Ask them to rejoin with one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この人は合言葉なしで参加しているため、部屋の主催者にはなれません。合言葉を付けて参加し直してもらってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对方没有用口令加入，所以不能主持这个房间。请让对方带上口令重新加入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對方沒有用密語加入，所以不能主持這個房間。請讓對方帶上密語重新加入。"
          }
        }
      }
    },
