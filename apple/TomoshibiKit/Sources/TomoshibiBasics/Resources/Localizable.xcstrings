    "This script carries the key to this deployment. Anybody who has it can add a relay, so do not put it anywhere it will be kept." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This script carries the key to this deployment. Anybody who has it can add a relay, so do not put it anywhere it will be kept."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このスクリプトはこの配備の鍵を持っています。持っている人は誰でも中継を追加できるので、残る場所には置かないでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这段脚本带着本部署的密钥。拿到它的人都能往这里加中转，所以别把它留在会被保存的地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這段指令稿帶著本部署的金鑰。拿到它的人都能往這裡加中轉，所以別把它留在會被保存的地方。"
          }
        }
      }
    },
