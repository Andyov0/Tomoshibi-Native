    "Every administrator can see everything. Only one who can manage everything can appoint administrators or give anybody Emby." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every administrator can see everything. Only one who can manage everything can appoint administrators or give anybody Emby."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者は全員すべてを閲覧できます。管理者の任命と Emby の許可は、すべてを管理できる管理者だけが行えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个管理员都能查看全部。只有可以管理全部的管理员能任命管理员,或给任何人开通 Emby。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個管理員都能檢視全部。只有可以管理全部的管理員能任命管理員,或給任何人開通 Emby。"
          }
        }
      }
    },
    "Every member of this room's scope runs it, so there is nobody to hand it to." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every member of this room's scope runs it, so there is nobody to hand it to."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この部屋は所属グループのメンバー全員が主催者なので、引き継ぐ相手はいません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个房间由所属组的每位成员共同主持，没有可以移交的人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這個房間由所屬群組的每位成員共同主持，沒有可以移交的人。"
          }
        }
      }
    },
    "Every sample as it is played, about a second behind" : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every sample as it is played, about a second behind"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再生中の音をサンプル単位でそのまま届けます。約1秒遅れます"
