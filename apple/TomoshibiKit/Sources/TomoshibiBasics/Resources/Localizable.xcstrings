          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐個取樣原樣送達,比即時慢約 1 秒"
          }
        }
      }
    },
    "Every viewer plays Bilibili's series and films through this deployment, members' episodes whole and up to 4K, sized to their player. Nobody needs a grant for it." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every viewer plays Bilibili's series and films through this deployment, members' episodes whole and up to 4K, sized to their player. Nobody needs a grant for it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての視聴者が Bilibili のシリーズや映画をこのデプロイ経由で視聴します。会員限定のエピソードも全編、最大 4K で、画質は各自のプレーヤーの大きさに合わせます。個別の許可は必要ありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有观众都经这个部署观看 B 站的番剧和电影,会员集完整播放,最高 4K,画质按各自播放器的大小来定。不需要任何人单独开通。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有觀眾都經這個部署觀看 B 站的番劇和電影,會員集完整播放,最高 4K,畫質按各自播放器的大小來定。不需要任何人單獨開通。"
          }
        }
      }
    },
