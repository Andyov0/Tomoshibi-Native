          }
        }
      }
    },
    "Tomoshibi is not allowed to install apps, so it could not install the update. Allow it on the next screen to try again." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomoshibi is not allowed to install apps, so it could not install the update. Allow it on the next screen to try again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomoshibi にアプリのインストールが許可されていないため、アップデートをインストールできませんでした。次の画面で許可してからもう一度お試しください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomoshibi 没有安装应用的权限，所以没能安装更新。在接下来的页面里允许后再试一次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
