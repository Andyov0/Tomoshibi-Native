    "Your connection is sending about {have} Mbps, and this share needs about {need} Mbps, so it stutters." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
