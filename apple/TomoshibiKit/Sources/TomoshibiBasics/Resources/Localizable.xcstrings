    "Emby figures count what was relayed since the server last started, and go back to nought when it restarts." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emby figures count what was relayed since the server last started, and go back to nought when it restarts."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emby の数値はサーバーが最後に起動してから中継した量で、再起動するとゼロに戻ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emby 的流量是自服务器上次启动以来中转的量,重启后归零。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emby 的流量是自伺服器上次啟動以來中轉的量,重啟後歸零。"
          }
        }
      }
    },
