    "macOS is running this copy of Tomoshibi from a temporary place. Move Tomoshibi into Applications in Finder, open it from there, and update again." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS is running this copy of Tomoshibi from a temporary place. Move Tomoshibi into Applications in Finder, open it from there, and update again."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS はこの Tomoshibi を一時的な場所から実行しています。Finder で Tomoshibi を「アプリケーション」フォルダに移動し、そこから開いてもう一度アップデートしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 正在从一个临时位置运行这份 Tomoshibi。请在访达里把 Tomoshibi 移到「应用程序」文件夹，从那里打开后再更新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 正在從一個暫時位置執行這份 Tomoshibi。請在 Finder 裡把 Tomoshibi 移到「應用程式」檔案夾，從那裡打開後再更新。"
          }
        }
      }
    },
