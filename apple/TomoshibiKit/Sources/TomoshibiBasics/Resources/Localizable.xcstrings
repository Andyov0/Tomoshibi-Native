      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ticked, the films this person picks from Emby are relayed through the CDN to everybody in the room, for as long as each of them watches."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックすると、この人が Emby から選んだ作品は CDN を経由して部屋の全員に中継されます。各自が見ている間ずっと中継されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾选后,此人从 Emby 选的片会经 CDN 中转给房间里的每个人,每人看多久就中转多久。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "勾選後,此人從 Emby 選的片會經 CDN 中轉給房間裡的每個人,每人看多久就中轉多久。"
          }
        }
      }
