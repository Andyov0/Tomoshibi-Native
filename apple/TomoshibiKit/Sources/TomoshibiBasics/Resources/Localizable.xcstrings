    "Tomoshibi is installing an update and will open again in a moment. Start or join the meeting then." : {
      "extractionState" : "manual",
      "generatesSymbol" : false,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomoshibi is installing an update and will open again in a moment. Start or join the meeting then."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomoshibi はアップデートをインストール中で、まもなく自動でもう一度開きます。会議の開始や参加はそのあとにしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
