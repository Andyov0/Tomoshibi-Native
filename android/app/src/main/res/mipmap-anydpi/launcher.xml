<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's icon: the mark on the iPhone icon's ground, which the
     launcher cuts to its own shape. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_ground" />
    <foreground android:drawable="@drawable/launcher_mark" />
    <monochrome android:drawable="@drawable/launcher_mark_monochrome" />
</adaptive-icon>
