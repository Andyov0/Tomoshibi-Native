<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The evening ground behind the first frame, as on the iPhone, so that
         the app does not open on white before Compose draws: in the dark,
         the black the screens stand on. -->
    <style name="Theme.Tomoshibi" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
