<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Tomoshibi.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!--
                The apps' palette (Theme.swift, Android's Theme.kt): dark in
                every system appearance, Apple's dark greys, and one signal
                colour, the tally, amber until the person chooses another.
                The screens, their layout and the glass come with the full UI.
            -->
            <SolidColorBrush x:Key="Background" Color="#FF0B0B0D" />
            <SolidColorBrush x:Key="Surface" Color="#FF1C1C1E" />
            <SolidColorBrush x:Key="SurfaceHigh" Color="#FF2C2C2E" />
            <SolidColorBrush x:Key="Border" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="Foreground" Color="#FFF5F5F7" />
            <SolidColorBrush x:Key="Muted" Color="#99EBEBF5" />
            <SolidColorBrush x:Key="Tally" Color="#FFFFA23B" />
            <SolidColorBrush x:Key="TallyForeground" Color="#FF1F1200" />
            <SolidColorBrush x:Key="Danger" Color="#FFFF453A" />
            <CornerRadius x:Key="TileRadius">8</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>
