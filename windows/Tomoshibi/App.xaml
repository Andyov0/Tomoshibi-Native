<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Tomoshibi.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        No RequestedTheme: the app's own theme is the system's choice for
        apps, as it changes. Each screen and each thing laid over one asks
        for its scheme's theme itself (Ink.Element), the meeting's dark
        whatever the system says (Tomoshibi.Basics.Daylight).
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary>
                    <!--
                        The apps' palette (Theme.swift, Android's Theme.kt, and
                        Tomoshibi.Basics.Theme, where the numbers live): Apple's
                        greys, dark and light, and one signal colour. The
                        Windows controls' own fills and fields are brought to
                        the same greys here, so that a TextBox or a ToggleSwitch
                        is the platform's control in the product's colours
                        rather than Windows' grey. The light ones are the dark
                        ones turned over as the palette turns its border over:
                        white washes become black at the same strength and the
                        ink becomes #1C1C1E; a field, black at a quarter over
                        the dark ground, is the raised grey #E5E5EA the palette
                        keeps for fills inside a surface (Ink.Well), white
                        while it is typed in. The accent's brushes are here for
                        each theme so that Ink.ApplyAccent can paint each in
                        its own scheme's tally.
                    -->
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="TextControlBackground" Color="#3D000000" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#52000000" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#52000000" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1AFFFFFF" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2EFFFFFF" />
                            <SolidColorBrush x:Key="TextControlForeground" Color="#FFF5F5F7" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFF5F5F7" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#99EBEBF5" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#99EBEBF5" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#99EBEBF5" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#24FFFFFF" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#33FFFFFF" />
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#1AFFFFFF" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFF5F5F7" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="ComboBoxBackground" Color="#12FFFFFF" />
                            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#21FFFFFF" />
                            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#17FFFFFF" />
                            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFA23B" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="TextControlBackground" Color="#FFE5E5EA" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FFDEDEE3" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="#1A000000" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#2E000000" />
                            <SolidColorBrush x:Key="TextControlForeground" Color="#FF1C1C1E" />
                            <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FF1C1C1E" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#993C3C43" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#993C3C43" />
                            <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#993C3C43" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#24000000" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#33000000" />
                            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#1A000000" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FF8E8E93" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FF636366" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFFFF" />
                            <SolidColorBrush x:Key="ComboBoxBackground" Color="#FFE5E5EA" />
                            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FFDEDEE3" />
                            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#17000000" />
                            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="TextControlElevationBorderFocusedBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="ProgressRingForegroundThemeBrush" Color="#FFFFA23B" />
                            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFA23B" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>

                    <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
                    <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>
                    <CornerRadius x:Key="TextControlCornerRadius">12</CornerRadius>

                    <!--
                        Every button the kit makes (UI/Kit/Tap.cs): only the
                        shape and what is in it. Its colours under the pointer
                        and the press are the kit's own, the apps' numbers,
                        rather than the default template's states, which
                        would turn a lamplit button grey under the pointer.
                        The brush moves to its new colour over the 140 ms a
                        press takes everywhere (the web's pressable). The
                        system's focus ring still draws round it for the
                        keyboard.
                    -->
                    <Style x:Key="Tap" TargetType="Button">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                        <Setter Property="FocusVisualMargin" Value="-3" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                        <Border.BackgroundTransition>
                                            <BrushTransition Duration="0:0:0.14" />
                                        </Border.BackgroundTransition>
                                        <ContentPresenter
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            Content="{TemplateBinding Content}"
                                            Foreground="{TemplateBinding Foreground}" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
