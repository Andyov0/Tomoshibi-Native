<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Windows app: WinUI 3 over the shared Rust core, which build-core.ps1
    builds into Native\win-<arch>\tomoshibi_core.dll and whose C# bindings it
    generates into Generated.

    Unpackaged, with the Windows App SDK and .NET carried in the output: the
    build directory runs as it is, without an installer, a signing
    certificate or a package registration, and a launch inherits the
    environment it was started with, which is how the TOMOSHIBI_* switches
    reach it (a packaged app is started by activation and does not).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Tomoshibi</RootNamespace>
    <AssemblyName>Tomoshibi</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>ARM64;x64</Platforms>
    <RuntimeIdentifiers>win-arm64;win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!--
      Unpackaged by default, for the tests; windows\package.ps1 builds the
      same project as an MSIX (WindowsPackageType=MSIX on its command line),
      with Package.appxmanifest, for distribution and for the tomoshibi://
      links only a package can register.
    -->
    <WindowsPackageType Condition="'$(WindowsPackageType)' == ''">None</WindowsPackageType>
    <!-- Program.Main, which hands a link to the app already running. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The generated bindings move memory across the FFI by pointer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The program's own picture, which the setup's shortcuts and the taskbar show. -->
    <ApplicationIcon>Assets\Tomoshibi.ico</ApplicationIcon>
    <!--
      The version, 0.1.4, and the build, 1, as the fourth part of the
      assembly's and the file's version (owner, 2026-10-22: a small fix keeps
      the version and takes the next build; a new version is for new features
      or a large update). ClientDescription joins them as the core's
      version_with_build does, 0.1.4 for build 1 and 0.1.4.2 for build 2, for
      the user agent and the update check. What a build made by hand says;
      setup.ps1 gives a release its own (-Version, -Build).
    -->
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.1</AssemblyVersion>
    <FileVersion>0.1.4.1</FileVersion>
    <!-- Generated code is not ours to keep tidy. -->
    <NoWarn>$(NoWarn);CS1591;CS8618;CS8625;CS8600;CS8602;CS8603;CS8604;CS0108</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>

  <!-- The flags drawn in for flag emoji, which Windows has no glyphs for (UI/Kit/Flags.cs). -->
  <ItemGroup>
    <Content Include="Assets\Flags\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The package's pictures, only in a packaged build. -->
  <ItemGroup Condition="'$(WindowsPackageType)' == 'MSIX'">
    <Content Include="Assets\*.png" />
  </ItemGroup>
  <!-- The rules the three platforms share, and their tests' subject. -->
  <ItemGroup>
    <ProjectReference Include="..\Tomoshibi.Basics\Tomoshibi.Basics.csproj" />
  </ItemGroup>

  <!--
    The phrase table, the one android/i18n.mjs writes from the catalog the
    Apple apps build from: read where Android keeps it, so that the platforms
    read one table and a phrase added to native.json reaches all three.
  -->
  <ItemGroup>
    <Content Include="..\..\android\app\src\main\assets\phrases.json">
      <Link>phrases.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    The web's person segmenter as ONNX, for the background blur
    (Media/BackgroundBlur.cs); made from web/public/segment by
    windows/Blur/convert.py.
  -->
  <ItemGroup>
    <Content Include="..\Blur\selfie_segmenter.onnx">
      <Link>segment\selfie_segmenter.onnx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The core, for the architecture being built. -->
  <ItemGroup>
    <None Include="Native\$(RuntimeIdentifier)\tomoshibi_core.dll" Condition="Exists('Native\$(RuntimeIdentifier)\tomoshibi_core.dll')">
      <Link>tomoshibi_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Native\$(RuntimeIdentifier)\tomoshibi_core.pdb" Condition="Exists('Native\$(RuntimeIdentifier)\tomoshibi_core.pdb')">
      <Link>tomoshibi_core.pdb</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="RequireCore" BeforeTargets="Build" Condition="!Exists('Generated') Or !Exists('Native\$(RuntimeIdentifier)\tomoshibi_core.dll')">
    <Error Text="No core for $(RuntimeIdentifier): run windows\build-core.ps1 first." />
  </Target>
</Project>
